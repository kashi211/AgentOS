# ─── Anthropic ───────────────────────────────────────────────
# Opus 4.7 for reasoning, Sonnet 4.6 for fast sub-tasks
ANTHROPIC_API_KEY=sk-ant-...

# ─── PostgreSQL — Neon ───────────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# ─── Redis — Upstash ─────────────────────────────────────────
UPSTASH_REDIS_URL=https://xxx.upstash.io
UPSTASH_REDIS_TOKEN=xxx

# ─── Vector DB — Pinecone ────────────────────────────────────
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX=agentos-memory

# ─── Backend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ─── Cloudflare R2 ───────────────────────────────────────────
# Backend (Railway) needs all of these to upload generated files
R2_ACCOUNT_ID=xxx
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET_NAME=agentos-artefacts
# Frontend (Vercel) only needs this to render download links
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxx.r2.dev
